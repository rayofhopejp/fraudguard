# family-web/.env.example — 実際の値を入れた .env.local はコミットしないこと

NEXT_PUBLIC_API_BASE_URL=https://api.fraudguard.example.com

# NextAuth (requirements.md 36.2章: 家族ユーザー認証はCognito)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_xxxxxxx

# requirements.md 16章: Web Push用Firebaseクライアント設定
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
