# server/.env.example — 実際の値を入れた .env はコミットしないこと(.gitignore済み)

DATABASE_URL=jdbc:postgresql://localhost:5432/fraudguard
DATABASE_USER=fraudguard
DATABASE_PASSWORD=change-me

# Cognito User Pool (requirements.md 36.2章)
COGNITO_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_xxxxxxx
COGNITO_AUDIENCE=

# Firebase Admin SDK サービスアカウントJSONのパス(未実装。8章の遠隔コマンド配信専用として温存)
FCM_SERVICE_ACCOUNT_PATH=/etc/fraudguard/fcm-service-account.json

# requirements.md 2.2章: 家族への一次通知はSlack Incoming Webhook経由。
# Slack App管理画面 > Incoming Webhooks で発行したURLを設定する。未設定なら通知は送信されない。
SLACK_WEBHOOK_URL=

# 遠隔コマンド署名用 Ed25519 秘密鍵(PEM)のパス(requirements.md 8.1章)
COMMAND_SIGNING_PRIVATE_KEY_PATH=/etc/fraudguard/command-signing-private.pem

PORT=8080
